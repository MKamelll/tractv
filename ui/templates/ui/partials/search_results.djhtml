{% if results %}
    <ul class="menu">
        {% for r in results %}
            <li>
                <a href="{% url 'shows' r.id %}"
                   data-search-item
                   class="flex justify-between">{{ r.name }}</a>
            </li>
        {% endfor %}
    </ul>
{% elif query %}
    <div class="p-4 text-sm text-base-content/60">No results for "{{ query }}"</div>
{% endif %}
