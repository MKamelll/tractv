<div x-data="card_actions('{{ status }}')"
     class="card bg-base-200 w-96 shadow-sm">
    {% if show.poster_path %}
        <figure class="p-4">
            <img src="{{ show.poster_path }}" class="w-300 h-auto" alt="show poster" />
        </figure>
    {% endif %}
    <div class="card-body">
        <form class="card-actions flex-col gap-4">
            {% csrf_token %}
            <button x-on:htmx:after-request="on_watchlist_response($event)"
                    x-bind:class="watchlist ? btn_success : btn_initial"
                    hx-swap="none"
                    hx-post="{% url 'status_update' show.id 'watchlist' %}">Watchlist</button>
            <button x-on:htmx:after-request="on_completed_response($event, $dispatch)"
                    x-bind:class="completed ? btn_success : btn_initial"
                    hx-swap="none"
                    hx-post="{% url 'status_update' show.id 'completed' %}">Completed</button>
            <button x-on:htmx:after-request="on_watching_response($event)"
                    x-bind:class="watching ? btn_success : btn_initial"
                    hx-swap="none"
                    hx-post="{% url 'status_update' show.id 'watching' %}">Watching</button>
        </form>
    </div>
</div>
<script>
    function card_actions(status) {
        return {
            watchlist: status === "watchlist",
            completed: status === "completed",
            watching: status === "watching",
            btn_success: "btn bg-success w-full",
            btn_initial: "btn btn-outline border-primary w-full",
            on_watchlist_response(event) {
                if (!event.detail.successful) return;
                this.watchlist = !this.watchlist;
                this.completed = false;
                this.watching = false;
            },
            on_completed_response(event, dispatch) {
                if (!event.detail.successful) return;
                this.completed = !this.completed;
                dispatch("show-completed", {status: this.completed});
                this.watchlist = false;
                this.watching = false;
            },
            on_watching_response(event) {
                if (!event.detail.successful) return;
                this.watching = !this.watching;
                this.watchlist = false;
                this.completed = false;
            }
        }
    }
</script>
