<div class="flex flex-row gap-4 h-full w-full items-start flex-1">
    {% if episode.still_path %}
        <img src="{{ episode.still_path }}"
             alt="episode_still"
             class="w-auto h-auto">
    {% endif %}
    <div class="flex flex-col gap-4 flex-1">
        <h1 class="text-xl font-serif">{{ episode.name }}</h1>
        <p class="text-sm">{{ episode.overview }}</p>
    </div>
    <button class="btn btn-circle bg-primary">
        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="2.5"
             stroke="currentColor"
             class="size-[1.2em]">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
    </button>
</div>
<div class="collapse collapse-arrow bg-base-200">
    <input type="checkbox" x-init="$el.checked = false" />
    <div class="collapse-title font-semibold">reviews</div>
    <div class="collapse-content">
        {% include "ui/shows/add_review.djhtml" %}
        <div class="divider"></div>
        <div class="flex flex-col gap-4">{% include "ui/shows/episode_comment.djhtml" %}</div>
    </div>
</div>
