<div x-data="episode_data({% if episode.id in watches %}true{% else %}false{% endif %})"
     class="flex flex-row gap-4 h-full w-full items-start flex-1">
    {% if episode.still_path %}
        <img src="{{ episode.still_path }}"
             alt="episode_still"
             class="w-auto h-auto">
    {% endif %}
    <div class="flex flex-col gap-4 flex-1">
        <h1 class="text-xl font-serif">{{ episode.name }}</h1>
        <p class="text-sm">{{ episode.overview }}</p>
    </div>
    <button class="btn btn-circle"
            x-bind:class="marked_watched ? btn_success : btn_initial"
            x-on:show-completed.window="marked_watched = $event.detail.status">
        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor"
             class="w-6 h-auto">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
    </button>
</div>
<div class="collapse collapse-arrow bg-base-200">
    <input type="checkbox" x-init="$el.checked = false" />
    <div class="collapse-title font-semibold">reviews</div>
    <div class="collapse-content">
        {% include "ui/shows/add_review.djhtml" %}
        <div class="divider"></div>
        <div class="flex flex-col gap-4">{% include "ui/shows/episode_comment.djhtml" %}</div>
    </div>
</div>
<script>
    function episode_data(status) {
        return {
            marked_watched: status,
            btn_success: "btn bg-success",
            btn_initial: "btn btn-outline border-primary",
        }
    }
</script>
