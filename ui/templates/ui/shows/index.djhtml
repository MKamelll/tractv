{% extends "ui/base.djhtml" %}
{% block title %}
    {{ show.name }}
{% endblock title %}
{% block body %}
    {% include "ui/components/navbar.djhtml" %}
    <div class="flex flex-row gap-4 p-4 w-full">
        <div class="flex flex-col gap-4 h-screen">{% include "ui/shows/poster_card.djhtml" %}</div>
        <div class="flex flex-col gap-4 h-screen flex-1">
            <div class="flex flex-row gap-4 items-end">
                <div class="flex flex-row items-end gap-4 flex-1">
                    <h1 class="text-5xl font-serif">{{ show.name }}</h1>
                    <h1 class="text-sm">{{ show.number_of_seasons }} seasons</h1>
                    <h1 class="text-sm">{{ show.number_of_episodes }} episodes</h1>
                </div>
                {% include "ui/shows/rating.djhtml" %}
                <c-ui.shows.rating />
            </div>
            <p class="bg-base-200 p-4">{{ show.overview }}</p>
            {% include "ui/shows/tabs.djhtml" %}
        </div>
    </div>
{% endblock body %}
